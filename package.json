      ],
      "stackerftp.editor.submenu": [
        {
          "command": "stackerftp.uploadToAllProfiles",
          "group": "1_upload@1"
        },
        {
          "command": "stackerftp.diff",
          "group": "2_compare@1"
        },
        {
          "command": "stackerftp.forceUpload",
          "group": "3_force@1"
        },
        {
          "command": "stackerftp.forceDownload",
          "group": "3_force@2"
        }
      ],
      "scm/title": [
        {
          "command": "stackerftp.uploadChangedFiles",
          "group": "stackerftp",
          "when": "scmProvider == git"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "stackerftp.uploadChangedFiles",
          "group": "inline",
          "when": "scmProvider == git && scmResourceGroup == workingTree"
        },
        {
          "command": "stackerftp.uploadChangedFiles",
          "group": "inline",
          "when": "scmProvider == git && scmResourceGroup == index"
        }
      ],
      "editor/title": [
        {
          "command": "stackerftp.editInLocal",
          "when": "resourceScheme == stackerftp-remote",
          "group": "navigation@1"
        }
      ]
    },
    "views": {
      "stackerftp-explorer": [
        {
          "type": "webview",
          "id": "stackerftp.dashboardLauncher",
          "name": "Open Dashboard",
          "when": "workspaceFolderCount > 0",
          "contextualTitle": "ITFFTP",
          "visibility": "visible",
          "icon": "$(dashboard)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stackerftp-explorer",
          "title": "ITFFTP",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "stackerftp.uploadCurrentFile",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus"
      },
      {
        "command": "stackerftp.download",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d"
      },
      {
        "command": "stackerftp.syncToRemote",
        "key": "ctrl+shift+alt+u",
        "mac": "cmd+shift+alt+u"
      },
      {
        "command": "stackerftp.syncToLocal",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d"
      },
      {
        "command": "stackerftp.uploadChangedFiles",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp.json",
        "url": "./schema/sftp.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node scripts/release-gate.js --prepublish",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node esbuild.js --minify",
    "bundle:dev": "node esbuild.js",
    "lint": "eslint src --ext ts --no-eslintrc --config .eslintrc.json",
    "test": "node scripts/run-tests.js",
    "release:gate": "node scripts/release-gate.js",
    "package": "node scripts/release-gate.js"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.11.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/codicons": "^0.0.35",
    "@vscode/vsce": "3.7.1",
    "ajv": "^8.17.1",
    "basic-ftp": "^5.2.1",
    "esbuild": "^0.27.3",
    "eslint": "^8.0.0",
    "ignore": "^5.3.0",
    "mime-types": "^2.1.35",
    "minimatch": "^9.0.0",
    "ovsx": "0.10.9",
    "ssh2": "^1.15.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0",
    "yauzl": "2.10.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
