  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "ITFFTP",
      "properties": {
        "stackerftp.showHiddenFiles": {
          "type": "boolean",
          "default": false,
          "description": "Show hidden files in remote explorer"
        },
        "stackerftp.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before deleting remote files"
        },
        "stackerftp.confirmSync": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before syncing directories"
        },
        "stackerftp.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Auto refresh remote explorer after operations"
        },
        "stackerftp.transferConcurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of concurrent file transfers (1-100; max connections = this + 1 primary)"
        },
        "stackerftp.dashboardZoom": {
          "type": "number",
          "default": 110,
          "minimum": 80,
          "maximum": 160,
          "description": "ITFFTP dashboard zoom percentage"
        },
        "stackerftp.showWebMasterTools": {
          "type": "boolean",
          "default": true,
          "description": "Show WebMaster commands in the Command Palette and explorer menus"
        },
        "stackerftp.enableFileWatcher": {
          "type": "boolean",
          "default": false,
          "description": "Watch local and remote files for changes and run enabled Auto Sync directions after a one-second quiet period"
        },
        "stackerftp.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reconnect when a connection drops"
        },
        "stackerftp.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to the active configured server after VS Code starts"
        },
        "stackerftp.defaultSyntaxHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Enable syntax highlighting for remote files"
        },
        "stackerftp.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "Download file instead of view content when opening in Remote Explorer"
        },
        "stackerftp.remoteExplorerSortOrder": {
          "type": "string",
          "default": "name",
          "enum": [
            "name",
            "size",
            "date",
            "type"
          ],
          "enumDescriptions": [
            "Sort by file name",
            "Sort by file size",
            "Sort by modification date",
            "Sort by file type (folders first)"
          ],
          "description": "Default sort order for Remote Explorer"
        },
        "stackerftp.remotes": {
          "type": "object",
          "default": {},
          "description": "Remote-FS Integration: Define reusable remote server configurations. Reference them in sftp.json with \"remote\": \"name\"",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for the remote"
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Hostname or IP address"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Port number"
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "sftp",
                  "ftp",
                  "ftps"
                ],
                "description": "Connection protocol"
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Username for authentication"
              },
              "password": {
                "type": "string",
                "description": "Password for authentication"
              },
              "privateKeyPath": {
                "type": "string",
                "minLength": 1,
                "description": "Path to SSH private key"
              },
              "passphrase": {
                "type": "string",
                "description": "Passphrase for the SSH private key"
              },
              "remotePath": {
                "type": "string",
                "minLength": 1,
                "description": "Default remote path"
              }
            },
            "required": [
              "host"
            ]
          }
        }
      }
    },
