{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ITFFTP Configuration",
  "description": "Workspace connection configuration for the ITFFTP VS Code extension",
  "oneOf": [
    { "$ref": "#/definitions/config" },
    {
      "type": "array",
      "items": { "$ref": "#/definitions/config" },
      "description": "Multiple ITFFTP connection configurations"
    }
  ],
  "definitions": {
    "protocol": {
      "type": "string",
      "enum": ["sftp", "ftp", "ftps"],
      "description": "Transfer protocol to use"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "TCP port for the remote service"
    },
    "localPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*$",
      "description": "Workspace-relative local directory; parent traversal and absolute paths are not allowed"
    },
    "autoSync": {
      "type": "string",
      "enum": ["off", "upload", "download", "both"],
      "default": "off",
      "description": "Transfer direction for local or remote changes after the file-watcher quiet period"
    },
    "remoteExplorerOrder": {
      "type": "string",
      "enum": ["name", "size", "date", "type"],
      "description": "Sort order for this connection in Remote Explorer"
    },
    "syncMode": {
      "type": "string",
      "enum": ["update", "full"],
      "default": "update",
      "description": "Compare source freshness before transfer, or compare the complete tree"
    },
    "syncOption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delete": { "type": "boolean", "default": false },
        "skipCreate": { "type": "boolean", "default": false },
        "ignoreExisting": { "type": "boolean", "default": false },
        "update": { "type": "boolean", "default": false }
      },
      "description": "Declared compatibility options for legacy synchronization profiles"
    },
    "collisionPolicy": {
      "type": "string",
      "enum": ["ask", "overwrite", "skip"],
      "default": "ask",
      "description": "How to handle a path that already exists at the transfer target"
    },
    "ignore": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": [".vscode", ".git", ".DS_Store", "node_modules"],
      "description": "Glob patterns and paths to exclude"
    },
    "watcher": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "string",
              "minLength": 1,
              "default": "**/*",
              "description": "Glob pattern for files to watch"
            },
            "autoUpload": {
              "type": "boolean",
              "default": true,
              "description": "Upload matching local changes"
            },
            "autoDelete": {
              "type": "boolean",
              "default": false,
              "description": "Delete the matching remote path after a local deletion"
            }
          }
        }
      ],
      "description": "Per-connection file-watcher options"
    },
    "secure": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["control", "implicit"] }
      ],
      "default": false,
      "description": "TLS mode for FTP/FTPS connections"
    },
    "hopConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "username"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Hostname of the SFTP jump server"
        },
        "port": { "$ref": "#/definitions/port" },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Username for the jump server"
        },
        "password": {
          "type": "string",
          "description": "Password for the jump server"
        },
        "privateKeyPath": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a private key for the jump server"
        },
        "passphrase": {
          "type": "string",
          "description": "Passphrase for the jump-server private key"
        }
      }
    },
    "hop": {
      "oneOf": [
        { "$ref": "#/definitions/hopConfig" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/hopConfig" }
        }
      ],
      "description": "SFTP jump host configuration"
    },
    "profileOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "default": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "port": { "$ref": "#/definitions/port" },
        "protocol": { "$ref": "#/definitions/protocol" },
        "username": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "password": { "type": "string" },
        "privateKeyPath": { "type": "string", "minLength": 1 },
        "passphrase": { "type": "string" },
        "remotePath": { "type": "string", "minLength": 1 },
        "localPath": { "$ref": "#/definitions/localPath" },
        "autoSync": { "$ref": "#/definitions/autoSync" },
        "uploadOnSave": { "type": "boolean" },
        "downloadOnOpen": { "type": "boolean" },
        "remoteExplorerOrder": { "$ref": "#/definitions/remoteExplorerOrder" },
        "syncMode": { "$ref": "#/definitions/syncMode" },
        "syncOption": { "$ref": "#/definitions/syncOption" },
        "collisionPolicy": { "$ref": "#/definitions/collisionPolicy" },
        "ignore": { "$ref": "#/definitions/ignore" },
        "watcher": { "$ref": "#/definitions/watcher" },
        "connTimeout": { "type": "integer", "minimum": 1 },
        "keepalive": { "type": "integer", "minimum": 0 },
        "secure": { "$ref": "#/definitions/secure" },
        "secureOptions": { "type": "object" },
        "passive": { "type": "boolean" },
        "hop": { "$ref": "#/definitions/hop" },
        "autoReconnect": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["host", "protocol", "username", "remotePath"] },
        { "required": ["remote"] }
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Friendly name for this connection"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "description": "Use this connection as the workspace default"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Hostname or IP address of the remote server"
        },
        "port": { "$ref": "#/definitions/port" },
        "protocol": { "$ref": "#/definitions/protocol" },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Username for authentication"
        },
        "password": {
          "type": "string",
          "description": "Password for authentication"
        },
        "privateKeyPath": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a private key for SFTP authentication"
        },
        "passphrase": {
          "type": "string",
          "description": "Passphrase for the SFTP private key"
        },
        "remotePath": {
          "type": "string",
          "minLength": 1,
          "default": "/",
          "description": "Remote directory to use as the connection root"
        },
        "localPath": { "$ref": "#/definitions/localPath" },
        "remote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Name of a reusable connection in the stackerftp.remotes VS Code setting"
        },
        "autoSync": { "$ref": "#/definitions/autoSync" },
        "uploadOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Legacy upload-side switch still consumed by the file watcher"
        },
        "downloadOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Download a remote file into the workspace when it is opened"
        },
        "remoteExplorerOrder": { "$ref": "#/definitions/remoteExplorerOrder" },
        "syncMode": { "$ref": "#/definitions/syncMode" },
        "syncOption": { "$ref": "#/definitions/syncOption" },
        "collisionPolicy": { "$ref": "#/definitions/collisionPolicy" },
        "ignore": { "$ref": "#/definitions/ignore" },
        "watcher": { "$ref": "#/definitions/watcher" },
        "profiles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/profileOverride" },
          "description": "Named partial overrides for this connection"
        },
        "defaultProfile": {
          "type": "string",
          "minLength": 1,
          "description": "Named profile applied by default"
        },
        "connTimeout": {
          "type": "integer",
          "minimum": 1,
          "default": 10000,
          "description": "Connection timeout in milliseconds"
        },
        "keepalive": {
          "type": "integer",
          "minimum": 0,
          "default": 300000,
          "description": "Keepalive interval in milliseconds; use 0 to disable it"
        },
        "secure": { "$ref": "#/definitions/secure" },
        "secureOptions": {
          "type": "object",
          "description": "Node.js TLS options for FTP/FTPS connections"
        },
        "passive": {
          "type": "boolean",
          "default": true,
          "description": "Use passive FTP mode"
        },
        "hop": { "$ref": "#/definitions/hop" },
        "autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "Reconnect after an unexpected connection loss"
        }
      }
    }
  }
}
